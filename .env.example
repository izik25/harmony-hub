DATABASE_URL=postgres://postgres:postgres@localhost:5432/sona
SESSION_SECRET=change-me-to-a-random-string

# Live streaming (optional) — sign up free at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# "Publish everywhere" — connect creator accounts and cross-post to external platforms.
# Each is independently optional: a platform without keys just shows as "not configured yet" in
# the publish modal instead of breaking anything else. Redirect URI to register with each
# provider is {your app origin}/api/connect/{youtube|tiktok|instagram}/callback — register it for
# both http://localhost:8080 (dev) and your production domain.

# Google Cloud Console -> new project -> enable "YouTube Data API v3" -> OAuth client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers -> app with the "Content Posting API" product added
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers -> app with "Instagram Graph API" added. Connecting account needs an
# Instagram Business/Creator account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
