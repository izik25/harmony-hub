DATABASE_URL=postgres://postgres:postgres@localhost:5432/sona
SESSION_SECRET=change-me-to-a-random-string

# "Continue with Google" sign-in/signup (optional) — reuses the same GOOGLE_CLIENT_ID/SECRET
# pair as the YouTube connect further down, just with a different OAuth scope. In Google Cloud
# Console, add {your app origin}/api/auth/google/callback as an additional authorized redirect URI
# on that same OAuth client (both http://localhost:8080 for dev and your production domain).
# Without these set, the login/signup pages simply hide the Google button.

# Phone sign-in via SMS one-time codes (optional) — uses Twilio Verify, which handles code
# generation/expiry/attempt-limiting for you. Console.twilio.com -> Verify -> Services -> create a
# service to get the Service SID; Account SID / Auth Token are on the console dashboard. Without
# these set, the login/signup pages simply hide the phone tab.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AI cover-image generation (optional) — powers the "Generate cover image" button on the publish
# screen. Get a key at https://platform.openai.com/api-keys. Without it, the button shows a
# "not configured" error and posts keep using the generated gradient cover.
OPENAI_API_KEY=

# Live streaming (optional) — sign up free at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# "Publish everywhere" — connect creator accounts and cross-post to external platforms.
# Each is independently optional: a platform without keys just shows as "not configured yet" in
# the publish modal instead of breaking anything else. Redirect URI to register with each
# provider is {your app origin}/api/connect/{youtube|tiktok|instagram}/callback — register it for
# both http://localhost:8080 (dev) and your production domain.

# Google Cloud Console -> new project -> enable "YouTube Data API v3" -> OAuth client ID (Web app).
# This same client ID/secret also powers "Continue with Google" sign-in above — see that comment
# for the extra redirect URI it needs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers -> app with the "Content Posting API" product added
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers -> app with "Instagram Graph API" added. Connecting account needs an
# Instagram Business/Creator account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
